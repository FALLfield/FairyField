{
  "manifest": {
    "id": "community.translator",
    "name": "Community Translator",
    "description": "Example local command translator declaration.",
    "category": "community",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Text to translate"
        },
        "target_lang": {
          "type": "string",
          "description": "Target language"
        }
      },
      "required": ["text", "target_lang"]
    },
    "permissions": ["execute_command"],
    "rate_limit": 5,
    "timeout_ms": 5000,
    "enabled_by_default": false,
    "version": "1.0.0",
    "author": "FairyField examples"
  },
  "provider": {
    "type": "local_command",
    "command": "fairy-translator",
    "args": ["{{parameters.target_lang}}", "{{parameters.text}}"]
  }
}
