# =============================================================================
# FairyField .gitignore
# =============================================================================

# ---- Dependencies ----
node_modules/
.pnp/
.pnp.js

# ---- Build artifacts ----
dist/
dist-ssr/
src-tauri/target/
src-tauri/gen/
target/

# ---- Rust ----
Cargo.lock
*.rlib

# ---- Tauri ----
src-tauri/WixTools/

# ---- TypeScript ----
*.tsbuildinfo

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.cursor/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.bak
*.orig

# ---- OS files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---- Environment & secrets ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# ---- Audio temp files ----
/tmp/
*.mp3
*.wav
*.webm
*.ogg

# ---- 3D model files (large binaries, use Git LFS or download separately) ----
*.glb
*.vrm
*.fbx
public/models/**/*.glb
public/models/**/*.vrm

# ---- sherpa-onnx downloaded models ----
models/

# ---- Agent & MCP runtime state ----
.omc/
.ruflo/
*.rvf
*.rvf.lock
agentdb/
*.db
*.db-shm
*.db-wal

# ---- Claude Code / AI editor config ----
.claude/
.rules/
.cursorrules
.copilot/

# ---- Generated files ----
graphify-out/
coverage/
.nyc_output/

# ---- User config (template kept as config/default.json) ----
config.json

# ---- macOS bundles ----
*.app

# ---- Archive files ----
*.zip
*.tar.gz
*.tgz
*.7z
